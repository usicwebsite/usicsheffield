# USIC Website (usicsheffield) environment variables
# Copy to .env.local and fill in real values. Do not commit secrets.

# --- Firebase client (required) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Admin (required for admin / server auth) ---
# Full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id"}
# Optional alternative to FIREBASE_SERVICE_ACCOUNT_KEY: path to a credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# --- Security ---
JWT_SECRET=your_secure_jwt_secret
# FORCE_HTTPS=true

# --- Cloudinary (required for profile photo and event image uploads) ---
CLOUDINARY_CLOUD_NAME=our_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Gemini (required for admin event AI parse) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Rate limiting (optional; defaults shown) ---
# Questions endpoint (3 per hour)
RATE_LIMIT_QUESTIONS_WINDOW_MS=3600000
RATE_LIMIT_QUESTIONS_PER_HOUR=3

# Posts endpoint (1 per hour for regular users)
RATE_LIMIT_POSTS_WINDOW_MS=3600000
RATE_LIMIT_POSTS_PER_HOUR=1

# Admin posts (10 per hour)
RATE_LIMIT_POSTS_ADMIN_WINDOW_MS=3600000
RATE_LIMIT_POSTS_ADMIN_PER_HOUR=10

# Auth attempts (20 per 15 minutes)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_ATTEMPTS=20

# Token refresh (30 per 5 minutes)
RATE_LIMIT_REFRESH_WINDOW_MS=300000
RATE_LIMIT_REFRESH_ATTEMPTS=30

# Admin operations (50 per hour)
RATE_LIMIT_ADMIN_WINDOW_MS=3600000
RATE_LIMIT_ADMIN_OPERATIONS=50

# API global (30 per minute)
RATE_LIMIT_API_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_API_GLOBAL_PER_MINUTE=30

# API auth (10 per minute)
RATE_LIMIT_API_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_AUTH_PER_MINUTE=10

# API public read (50 per minute)
RATE_LIMIT_API_PUBLIC_READ_WINDOW_MS=60000
RATE_LIMIT_API_PUBLIC_READ_PER_MINUTE=50

# Images (100 per minute)
RATE_LIMIT_IMAGES_WINDOW_MS=60000
RATE_LIMIT_IMAGES_PER_MINUTE=100

# Cleanup interval (5 minutes)
RATE_LIMIT_CLEANUP_INTERVAL_MS=300000
